# 复制为 .env.development / .env.production 后按需修改

# 开发冷启动优化：code-inspector 默认关闭；需要 DOM 定位 IDE 时设为 1
# CODE_INSPECTOR=1

# REST API：开发建议 '/'（走 Vite 代理）；生产填后端地址或同域 '/'
VITE_API_URL=/
# 全局 API 最大并发数，默认 6
# VITE_API_MAX_CONCURRENT=6

VITE_BASE_HOME_PATH=/home
VITE_BASE_Title=ERP 管理系统
VITE_APP_RELEASE=erp-web@dev
