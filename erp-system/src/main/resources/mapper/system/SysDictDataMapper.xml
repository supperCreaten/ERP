<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
		PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
		"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.system.mapper.SysDictDataMapper">

	<resultMap type="com.erp.system.domain.dto.SysDictDataSaveReq" id="SysDictResult">
		<id     property="id"             column="id"        />
		<result property="dictId"       	column="dict_id"      />
		<result property="dictLabel"       column="dict_label"    />
		<result property="dictValue"       column="dict_value"    />
		<result property="status"         column="status"         />
		<result property="remark"         column="remark"         />
		<result property="createBy"       column="create_by"      />
		<result property="createTime"     column="create_time"    />
		<result property="updateTime"     column="update_time"    />
		<result property="updateBy"       column="update_by"      />
	</resultMap>
	<sql id="selectDictDataVo">
        select * from sys_dict_data
    </sql>

    <select id="selectDictDataList" parameterType="com.erp.system.domain.dto.SysDictDataSaveReq" resultMap="SysDictResult">
		<include refid="selectDictDataVo"/>
		<where>
			is_del = '0'
			<if test="dictLabel != null and dictLabel != ''">
				AND dict_name like concat('%', #{dictLabel}, '%')
			</if>
			<if test="dictValue != null and dictValue != ''">
				AND dict_value = #{dictValue}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
		</where>
		order by dict_id
    </select>
	<select id="selectDictDataByDictId" resultMap="SysDictResult">
		<include refid="selectDictDataVo"/>
		where is_del = '0' and dict_id = #{id}
		order by id
	</select>
	<insert id="insertDictData" parameterType="com.erp.system.domain.dto.SysDictDataSaveReq">
		insert into sys_dict_data(
		dict_label,
		dict_value,
		dict_id,
		status,
		is_del,
		create_by,
		update_by,
		create_time,
		update_time
		)values(
		<choose>
			<when test="dictLabel != null and dictLabel != ''">#{dictLabel},</when>
			<otherwise>'',</otherwise>
		</choose>
		<choose>
			<when test="dictValue != null and dictValue != ''">#{dictValue},</when>
			<otherwise>'',</otherwise>
		</choose>
		<choose>
			<when test="dictId != null and dictId != ''">#{dictId},</when>
			<otherwise>'',</otherwise>
		</choose>
		<choose>
			<when test="status != null and status != ''">#{status},</when>
			<otherwise>'0',</otherwise>
		</choose>
		'0',
		<choose>
			<when test="createBy != null and createBy != ''">#{createBy},</when>
			<otherwise>'admin',</otherwise>
		</choose>
		<choose>
			<when test="updateBy != null and updateBy != ''">#{updateBy},</when>
			<otherwise>'admin',</otherwise>
		</choose>
		sysdate(),
		sysdate()
		)
	</insert>
	<update id="updateDictData" parameterType="com.erp.system.domain.dto.SysDictDataSaveReq">
		update sys_dict_data
		<set>
			<if test="dictLabel != null and dictLabel != ''">dict_label = #{dictLabel},</if>
			<if test="dictValue != null and dictValue != ''">dict_value = #{dictValue},</if>
			<if test="status != null">status = #{status},</if>
			<if test="remark != null and remark !=''">remark = #{remark},</if>
			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
			update_time = sysdate()
		</set>
		where id = #{id}
	</update>
	<delete id="deleteDictDataById" parameterType="Long">
	    update sys_dict_data set is_del = '1', update_time = sysdate() where id = #{id}
	</delete>
	<delete id="deleteDictDataByDictId" parameterType="Long">
		update sys_dict_data set is_del = '1', update_time = sysdate() where dict_id = #{id}
	</delete>
</mapper>
