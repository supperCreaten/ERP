<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.system.mapper.SysFileInfoMapper">

    <resultMap type="com.erp.system.domain.SysFileInfo" id="SysFileInfoResult">
        <id     property="fileId"            column="file_id" />
        <result property="originalFilename"  column="original_filename" />
        <result property="fileName"          column="file_name" />
        <result property="newFileName"       column="new_file_name" />
        <result property="url"               column="url" />
        <result property="fileSize"          column="file_size" />
        <result property="fileType"          column="file_type" />
        <result property="contentType"       column="content_type" />
        <result property="isDel"             column="is_del" />
        <result property="createBy"          column="create_by" />
        <result property="createTime"        column="create_time" />
        <result property="updateBy"          column="update_by" />
        <result property="updateTime"        column="update_time" />
        <result property="remark"            column="remark" />
    </resultMap>

    <insert id="insertFile" parameterType="com.erp.system.domain.SysFileInfo"
            useGeneratedKeys="true" keyProperty="fileId" keyColumn="file_id">
        insert into sys_file (
            original_filename, file_name, new_file_name, url,
            file_size, file_type, content_type, is_del,
            create_by, create_time, remark
        ) values (
            #{originalFilename}, #{fileName}, #{newFileName}, #{url},
            #{fileSize}, #{fileType}, #{contentType}, '0',
            #{createBy}, sysdate(), #{remark}
        )
    </insert>

    <select id="selectFileById" parameterType="Long" resultMap="SysFileInfoResult">
        select file_id, original_filename, file_name, new_file_name, url,
               file_size, file_type, content_type, is_del,
               create_by, create_time, update_by, update_time, remark
        from sys_file
        where file_id = #{fileId} and is_del = '0'
    </select>
</mapper>
