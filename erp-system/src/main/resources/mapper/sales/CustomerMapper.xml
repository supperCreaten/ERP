<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.system.mapper.CustomerMapper">

    <resultMap id="CustomerResult" type="com.erp.system.domain.vo.CustomerVO">
        <id     property="customerId"           column="customer_id"/>
        <result property="customerName"         column="customer_name"/>
        <result property="shortName"            column="short_name"/>
        <result property="province"             column="province"/>
        <result property="city"                 column="city"/>
        <result property="address"              column="address"/>
        <result property="creditLevel"          column="credit_level"/>
        <result property="category"             column="category"/>
        <result property="bankName"             column="bank_name"/>
        <result property="invoiceAddress"       column="invoice_address"/>
        <result property="bankAccount"          column="bank_account"/>
        <result property="taxNumber"            column="tax_number"/>
        <result property="contactPerson"        column="contact_person"/>
        <result property="contactPhone"         column="contact_phone"/>
        <result property="isDel"                column="is_del"/>
        <result property="createBy"             column="create_by"/>
        <result property="createTime"           column="create_time"/>
        <result property="updateBy"             column="update_by"/>
        <result property="updateTime"           column="update_time"/>
        <result property="remark"               column="remark"/>
    </resultMap>

    <sql id="selectCustomerVo">
        select c.customer_id, c.customer_name, c.short_name, c.province,city, c.address,c.invoice_address,
        c.credit_level, c.category, c.bank_name, c.bank_account, c.tax_number,
        c.contact_person, c.contact_phone, c.is_del, c.create_by, c.create_time, c.update_by, c.update_time, c.remark,d2.dict_label as categoryText , d1.dict_label as creditLevelText
        from biz_customer c left join sys_dict_data d1 on c.credit_level = d1.dict_value left join sys_dict_data d2 on c.category = d2.dict_value
    </sql>

    <select id="selectCustomerList" parameterType="com.erp.system.domain.dto.CustomerQueryDTO" resultMap="CustomerResult">
        <include refid="selectCustomerVo"/>
        <where>
            c.is_del = '0'
            <if test="customerName != null and customerName != ''">
                AND c.customer_name like concat('%', #{customerName}, '%')
            </if>

            <if test="creditLevel != null and creditLevel != ''">
                AND c.credit_level = #{creditLevel}
            </if>
            <if test="category != null and category != ''">
                AND c.category = #{category}
            </if>
            <if test="province != null and province != ''">
                AND c.province = #{province}
            </if>
            <if test="city != null and city != ''">
                AND c.city = #{city}
            </if>
            and d1.is_del = '0' and d2.is_del = '0'
        </where>
        order by customer_id desc
    </select>

    <select id="selectCustomerById" parameterType="Long" resultMap="CustomerResult">
        <include refid="selectCustomerVo"/>
        where c.customer_id = #{customerId} and c.is_del = '0'
    </select>

    <select id="selectCustomerByCustomerName" parameterType="com.erp.system.domain.dto.CustomerQueryDTO" resultMap="CustomerResult">
        <include refid="selectCustomerVo"/>
        <where>
            c.is_del = '0'
            <if test="customerName != null and customerName != ''">
                AND c.customer_name = #{customerName}
            </if>
            <if test="province != null and province != ''">
                AND c.province = #{province}
            </if>
            <if test="city != null and city != ''">
                AND c.city = #{city}
            </if>
        </where>
    </select>

    <insert id="insertCustomer" parameterType="com.erp.system.domain.dto.CustomerAddDTO"
            useGeneratedKeys="true" keyProperty="customerId" keyColumn="customer_id">
        insert into biz_customer (
            customer_name,
            short_name,
            province,
            city,
            address,
            credit_level,
            category,
            bank_name,
            invoice_address,
            bank_account,
            tax_number,
            contact_person,
            contact_phone,
            is_del,
            create_by,
            create_time,
            update_by,
            update_time,
            remark
        ) values (
            #{customerName},
            #{shortName},
            #{province},
            #{city},
            #{address},
            #{creditLevel},
            #{category},
            #{bankName},
            #{invoiceAddress},
            #{bankAccount},
            #{taxNumber},
            #{contactPerson},
            #{contactPhone},
            '0',
            #{createBy},
            sysdate(),
            #{updateBy},
            sysdate(),
            #{remark}
        )
    </insert>

    <update id="updateCustomer" parameterType="com.erp.system.domain.dto.CustomerAddDTO">
        update biz_customer
        <set>
            <if test="customerName != null and customerName != ''">customer_name = #{customerName},</if>
            <if test="shortName != null and shortName != ''">short_name = #{shortName},</if>
            <if test="province != null and province != ''">province = #{province},</if>
            <if test="city != null and city != ''">city = #{city},</if>
            <if test="address != null and address != ''">address = #{address},</if>
            <if test="creditLevel != null and creditLevel != ''">credit_level = #{creditLevel},</if>
            <if test="category != null and category != ''">category = #{category},</if>
            <if test="bankName != null and bankName != ''">bank_name = #{bankName},</if>
            <if test="invoiceAddress != null and invoiceAddress != ''">invoice_address = #{invoiceAddress},</if>
            <if test="bankAccount != null and bankAccount != ''">bank_account = #{bankAccount},</if>
            <if test="taxNumber != null and taxNumber != ''">tax_number = #{taxNumber},</if>
            <if test="contactPerson != null and contactPerson != ''">contact_person = #{contactPerson},</if>
            <if test="contactPhone != null and contactPhone != ''">contact_phone = #{contactPhone},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where customer_id = #{customerId} and is_del = '0'
    </update>

    <update id="deleteCustomerByIds" parameterType="Long">
        update biz_customer
        set is_del = '1', update_time = sysdate()
        where customer_id in
        <foreach collection="customerIds" item="item" open="(" separator="," close=")">
            #{item}
        </foreach>
    </update>

</mapper>
